# An .aiignore file follows the same syntax as a .gitignore file.
# .gitignore documentation: https://git-scm.com/docs/gitignore

# Dependencies and repository metadata
node_modules/
.git/

# Local secrets and credentials
.env
.env.*
.npmrc
*.pem
*.key

# Local IDE and operating-system files
.idea/
.vscode/
*.iml
.DS_Store

# Logs and temporary files
*.log
*.tmp

# Build output
dist/
build/
out/

# Coverage output (nyc/Istanbul)
coverage/
.nyc_output/
lib-cov/

# Generated documentation and VitePress output; edit source JSDoc and guides instead
/docs/api/
/docs/_build/
/docs/.vitepress/cache/
/docs/.vitepress/dist/
# Generated by docs:setup; read /CONTRIBUTING.md instead
/docs/guide/contributing.md
